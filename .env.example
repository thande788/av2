# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3010"
FROM_EMAIL="Angel Touch Homecare <noreply@example.com>"

# File uploads (Azure Blob)
# Preferred: Managed Identity + account name (no connection string)
AZURE_STORAGE_ACCOUNT_NAME="yourstorageaccount"
AZURE_STORAGE_BLOB_ENDPOINT="https://yourstorageaccount.blob.core.windows.net"
AZURE_STORAGE_CONTAINER="uploads"
AZURE_STORAGE_UPLOADS_CONTAINER="uploads"
AZURE_STORAGE_MARKETING_CONTAINER="uploads"
AZURE_STORAGE_COMPLIANCE_CONTAINER="uploads"

# Optional fallback (local/dev): connection string
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Feature flags
NEXT_PUBLIC_DEMO_MODE="false"
NEXT_PUBLIC_FEATURE_EMPLOYEE_PORTAL="false"
NEXT_PUBLIC_FEATURE_CLIENT_PORTAL="false"
NEXT_PUBLIC_FEATURE_SHIFTS="false"
NEXT_PUBLIC_FEATURE_SMS="false"
NEXT_PUBLIC_FEATURE_TIMESHEETS="false"
NEXT_PUBLIC_FEATURE_INVOICING="false"
NEXT_PUBLIC_FEATURE_COMPLIANCE="false"
NEXT_PUBLIC_FEATURE_PAYROLL="false"
NEXT_PUBLIC_FEATURE_WORKERS="false"
NEXT_PUBLIC_FEATURE_CLIENTS="false"
NEXT_PUBLIC_FEATURE_REVIEWS="false"
NEXT_PUBLIC_FEATURE_AVAILABILITY_CALENDAR="false"
NEXT_PUBLIC_FEATURE_SHIFT_BROADCAST="false"
NEXT_PUBLIC_FEATURE_SHIFT_NOTES="false"
NEXT_PUBLIC_FEATURE_EMERGENCY="false"
NEXT_PUBLIC_FEATURE_SHIFT_REMINDERS="false"
NEXT_PUBLIC_FEATURE_SATISFACTION="false"
NEXT_PUBLIC_FEATURE_SHIFT_SWAPS="false"
NEXT_PUBLIC_FEATURE_INVOICE_PAYMENTS="false"

# PII encryption (required in production)
PII_ACTIVE_KEY_ID="k1"
PII_KEYRING_JSON='{"k1":"BASE64_32_BYTE_KEY"}'
PII_HASH_KEY="BASE64_32_BYTE_KEY"

# Optional dev fallback (do not use in production)
PII_ENCRYPTION_KEY="BASE64_32_BYTE_KEY"
